# ── ReadyDay — Variables de entorno ──────────────────────────
# Copia este archivo a .env y llena los valores reales.
# En Railway: agregar como environment variables en el dashboard.

# ── Base de datos ─────────────────────────────────────────────
# Dev: SQLite (automático, no requiere configuración)
# Prod: Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXXXX.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://XXXXXX.supabase.co
SUPABASE_KEY=eyJhbGci...

# ── Anthropic (Claude API para explicaciones) ─────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────
ENV=production
