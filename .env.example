# ReadyDay — Variables de entorno
# Copiar a .env y llenar valores reales

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-en-produccion

# ── Claude API (explicaciones en lenguaje natural) ─────────────────────────────
# Si está vacío, usa plantillas predefinidas (la app funciona igual)
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Push Notifications Android (FCM) ──────────────────────────────────────────
# console.firebase.google.com → Proyecto → Configuración → Cloud Messaging
# Legacy server key (o usar service account para FCM v1)
FCM_SERVER_KEY=

# ── Encriptación credenciales Garmin ──────────────────────────────────────────
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Horario notificación mañanera (hora del servidor, UTC-5 = Colombia) ────────
NOTIFICATION_HOUR=7
NOTIFICATION_MINUTE=0

# ── CORS (separados por coma si múltiples) ─────────────────────────────────────
# En producción, reemplazar con tu dominio real
# ALLOWED_ORIGINS=https://readyday.app,https://www.readyday.app

# ── Base de datos ──────────────────────────────────────────────────────────────
# SQLite (default, no requiere configuración)
# DATABASE_URL=sqlite:////app/data/readyday.db
# Para PostgreSQL (Supabase):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXXX.supabase.co:5432/postgres
