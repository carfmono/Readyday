{
  "name": "Garmin Recovery Dashboard",
  "dataColors": [
    "#0F6CBD",
    "#2AA198",
    "#F59E0B",
    "#DC2626",
    "#6B7280",
    "#8B5CF6"
  ],
  "background": "#FFFFFF",
  "foreground": "#111827",
  "tableAccent": "#0F6CBD",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#111827"
              }
            }
          }
        ],
        "background": [
          {
            "show": false,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 6
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#111827"
              }
            },
            "fontSize": 30
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 11
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#111827"
              }
            },
            "textSize": 11
          }
        ]
      }
    }
  }
}